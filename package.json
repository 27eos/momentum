{
  "name": "momentum",
  "version": "0.1.0",
  "description": "Momentum — a dopamine-focused to-do app for TSplus work",
  "author": "Daniel Dvorsky",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "electron:dev": "cross-env MOMENTUM_DEV_URL=http://localhost:5273 electron .",
    "electron:build": "npm run build && electron-builder",
    "electron:dir": "npm run build && electron-builder --dir",
    "release": "npm run build && electron-builder --publish always",
    "ship": "npm version patch && git push --follow-tags"
  },
  "build": {
    "appId": "com.dvorsky.momentum",
    "productName": "Momentum",
    "directories": {
      "output": "${env.LOCALAPPDATA}/MomentumBuild",
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "27eos",
        "repo": "momentum"
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Momentum"
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.1"
  }
}
